// JCM configuration for interactive Godot simulation
// Loads checkpoints/alice50.pt for navigation

mas vesna {

    agent alice50:alice.asl {
        ag-class:   vesna.VesnaAgent
        address:    localhost
        port:       9080
        goals:      start
    }
    agent bob:bob.asl {
        ag-class:   vesna.VesnaAgent
        address:    localhost
        port:       9081          // Different port!
        goals:      start
    }
}
