// JCM configuration for 100-region RL training
// 8 parallel agents share ONE Python DQN policy + replay buffer.
// Each agent runs its own episode loop independently.

mas vesna_navigation_rl_100 {

    agent alice_1:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_2:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_3:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_4:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_5:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_6:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_7:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }
    agent alice_8:alice_navigation_rl_100.asl {
        goals: start
        cycle_sleep: 0
    }

}
